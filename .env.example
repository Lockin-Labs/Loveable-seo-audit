# Loveable UI Environment Variables

# Application Insights
VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=your_application_insights_connection_string

# Application Version
VITE_APP_VERSION=1.0.0

# API Configuration
# The API URL is configured in vite.config.ts to proxy to http://localhost:7071
# No need to set VITE_API_URL unless you want to override the proxy

# Additional environment variables can be added here as needed